# The build context is the repository root, so the API's Dockerfile can carry
# the skill folder alongside it. Everything here is either rebuilt inside the
# image or has no business in it.
.git/
.github/
.venv/
__pycache__/
*.pyc
.claude/
.playwright-mcp/

# The image needs api/ and embedded-iot-mentor/, nothing else.
vscode-copilot/

