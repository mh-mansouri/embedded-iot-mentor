{
  "name": "embedded-iot-mentor-vscode",
  "displayName": "Embedded / IoT Mentor",
  "description": "Opens the Embedded / IoT Mentor prompt and copies it, ready to paste into GitHub Copilot Chat.",
  "version": "0.0.1",
  "publisher": "your-name",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mh-mansouri/embedded-iot-mentor.git",
    "directory": "vscode-extension"
  },
  "bugs": {
    "url": "https://github.com/mh-mansouri/embedded-iot-mentor/issues"
  },
  "homepage": "https://github.com/mh-mansouri/embedded-iot-mentor#readme",
  "categories": [
    "Other"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "embeddedIoTMentor.openPrompt",
        "title": "Embedded / IoT Mentor: Open Copilot Prompt"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "typescript": "^5.6.0"
  }
}
